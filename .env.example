# Copy to .env (git-ignored) and fill in. The API reads it at startup.

# The four digits a parent types to open the parent screen.
MANTEL_PARENT_PIN=
# A long random string; the photo upload (Shortcut or make photos) sends it.
MANTEL_UPLOAD_TOKEN=

# A private calendar's URL is a password, so it lives here, not in
# settings.yaml: Google Calendar's "Secret address in iCal format".
# The pattern is MANTEL_CAL_<KID_ID>, the child's id from family.yaml in
# capitals, named by that feed's url_env in settings.yaml.
# The family's shared calendar.
MANTEL_CAL_FAMILY=
# Mira's own calendar.
MANTEL_CAL_MIRA=
# Kabir's own calendar.
MANTEL_CAL_KABIR=
