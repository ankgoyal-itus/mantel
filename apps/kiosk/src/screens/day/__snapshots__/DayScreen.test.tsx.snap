k:var(--chip-ink-mira, var(--ink-mira, #1F8A8A))" data-kid-card="mira"><div class="kid-head"><span class="avatar" style="width:56px;height:56px" data-avatar="fox"><img class="avatar-animal" src="/src/avatars/fox.svg?no-inline" alt="" draggable="false"/></span><h2 class="kid-name">Mira</h2></div><p class="kid-headline"><span class="kid-headline-what clamp-1"><span class="kid-headline-keep clamp-1">up to +30 today</span><span class="kid-headline-rest clamp-1"> · 6 things today · Assembly at 9:00 am</span></span></p><ul class="rows"><li class="row row-later"><span class="row-dot" aria-hidden="true"></span><span class="row-time clamp-1">All day</span><span class="row-title clamp-1">Picture day</span><span class="hide-under-120"></span></li><li class="row row-next"><span class="row-dot row-dot-on" aria-hidden="true"></span><span class="row-time clamp-1">9:00 am</span><span class="row-title clamp-1">Assembly</span><span class="hide-under-120"><span class="row-where clamp-1">Gym</span></span></li><li class="row row-later"><span class="row-dot" aria-hidden="true"></span><span class="row-time clamp-1">4:00 pm</span><span class="row-title clamp-1">Piano</span><span class="hide-under-120"><span class="row-where clamp-1">Ms. Lee&#x27;s</span></span></li></ul><ul class="chips"><li class="chip-task chip-task-open"><span class="chip-task-ring" aria-hidden="true"></span><span class="chip-task-title">Homework</span><span class="chip-task-worth">+10</span></li><li class="chip-task chip-task-open"><span class="chip-task-ring" aria-hidden="true"></span><span class="chip-task-title">30 min outside</span><span class="chip-task-worth">+10</span></li><li class="chip-task chip-task-open"><span class="chip-task-ring" aria-hidden="true"></span><span class="chip-task-title">Tidy room</span><span class="chip-task-worth">+10</span></li></ul><canvas class="confetti" aria-hidden="true"></canvas></section><section class="kid kid-budgeted" style="--kid:var(--shade-kabir, var(--kid-kabir, #D97706));--kid-tint:var(--tint-kabir, transparent);--kid-ink:var(--ink-kabir, #D97706);--kid-chip-ink:var(--chip-ink-kabir, var(--ink-kabir, #D97706))" data-kid-card="kabir"><div class="kid-head"><span class="avatar" style="width:56px;height:56px" data-avatar="panda"><img class="avatar-animal" src="/src/avatars/panda.svg?no-inline" alt="" draggable="false"/></span><h2 class="kid-name">Kabir</h2></div><p class="kid-headline"><span class="kid-headline-what clamp-1"><span class="kid-headline-keep clamp-1">up to +20 today</span><span class="kid-headline-rest clamp-1"> · 2 things today</span></span></p><p class="empty empty-drawn"><svg width="32" height="32" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M24 6 38 22 24 38 10 22Z" fill="currentColor" opacity="0.14" stroke="none"></path><path d="M24 6 38 22 24 38 10 22ZM24 6v32M10 22h28M24 38q-2 6 2 8t-1 4" vector-effect="non-scaling-stroke"></path></svg>Free afternoon</p><ul class="chips"><li class="chip-task chip-task-open"><span class="chip-task-ring" aria-hidden="true"></span><span class="chip-task-title">Homework</span><span class="chip-task-worth">+10</span></li><li class="chip-task chip-task-open"><span class="chip-task-ring" aria-hidden="true"></span><span class="chip-task-title">30 min outside</span><span class="chip-task-worth">+10</span></li></ul><p class="kid-foot"><span class="kid-foot-earned">+0 today</span> · <span class="kid-foot-left">+20 still to earn</span></p><canvas class="confetti" aria-hidden="true"></canvas></section></div><div class="day-bottom"><section class="dp-card"><h3 class="dp-head"><span class="dp-label">Today</span><span class="hide-under-140"></span></h3><ul class="dp-meals"><li class="dp-meal"><span class="dp-meal-label">Breakfast</span><span class="meal-name clamp-1">Oatmeal with fruit</span><span class="hide-under-120"></span></li><li class="dp-meal"><span class="dp-meal-label">Lunch</span><span class="meal-name clamp-1">Quesadilla</span><span class="hide-under-120"><span class="dp-meal-note clamp-1">Mira: no tomato</span></span></li><li class="dp-meal"><span class="dp-meal-label">Dinner</span><span class="meal-name clamp-1">Paneer tikka</span><span class="hide-under-120"><span class="dp-meal-note clamp-1">chicken tikka for the kids</span></span></li></ul></section><section class="dp-card"><h3 class="dp-head"><span class="dp-label">Tomorrow</span><span class="hide-under-120"><span class="dp-date clamp-1">· Wed 30 Sep</span></span><span class="dp-temps">74° / 52°</span><span class="dp-chip dp-chip-school clamp-1">No school</span><button type="button" class="dp-events"><svg class="dp-events-glyph" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 6.5h14A1.5 1.5 0 0 1 20.5 8v11A1.5 1.5 0 0 1 19 20.5H5A1.5 1.5 0 0 1 3.5 19V8A1.5 1.5 0 0 1 5 6.5ZM8 3.5v5M16 3.5v5M3.5 12h17" vector-effect="non-scaling-stroke"></path></svg>3 events</button></h3><ul class="dp-meals"><li class="dp-meal"><span class="dp-meal-label">Breakfast</span><span class="meal-name clamp-1">Pancakes</span><span class="hide-under-120"></span></li><li class="dp-meal"><span class="dp-meal-label">Lunch</span><span class="meal-name clamp-1">Dal and rice</span><span class="hide-under-120"><span class="dp-meal-note clamp-1">lunchbox</span></span></li><li class="dp-meal"><span class="dp-meal-label">Dinner</span><span class="meal-name dp-meal-empty">—</span></li></ul></section></div></div>"`;
