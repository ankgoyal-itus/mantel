exports[`a district feed's long titles > renders them 1`] = `"<div class="screen day"><header class="day-header"><div class="day-header-left"><div class="day-date clamp-1"><span class="day-date-long">Tuesday 29</span><span class="day-date-short">Tue 29</span></div><div class="day-sub"><span class="hide-under-140"></span></div></div><div class="day-clock" data-clock="true">3:30<span class="day-meridiem">pm</span></div><div class="day-weather"><svg class="wx-icon" width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M17 5.5V4M21 9h1.5M19.6 6.4 20.7 5.3M14.4 6.4 13.3 5.3M17 6.5a2.5 2.5 0 0 1 2.4 3.2M6.5 19.5h9a3.75 3.75 0 0 0 .4-7.5 5.6 5.6 0 0 0-10.9 1.5 3.5 3.5 0 0 0 1 6Z" vector-effect="non-scaling-stroke"></path></svg><div class="wx-text"><div class="wx-now">68°</div><div class="wx-detail">79° / 56°</div></div></div></header><div class="fam"><div class="fam-row"><button type="button" class="fam-tap" data-pill="0"><span class="fam-pill"><span class="fam-when">6:30 pm</span><span class="fam-what">Dinner with grandparents</span></span></button></div></div><div class="day-kids"><section class="kid kid-budgeted" style="--kid:var(--shade-mira, var(--kid-mira, #1F8A8A));--kid-tint:var(--tint-mira, transparent);--kid-ink:var(--ink-mira, #1F8A8A);--kid-chip-ink:var(--chip-ink-mira, var(--ink-mira, #1F8A8A))" data-kid-card="mira"><div class="kid-head"><span class="avatar" style="width:56px;height:56px" data-avatar="fox"><img class="avatar-animal" src="/src/avatars/fox.svg?no-inline" alt="" draggable="false"/></span><h2 class="kid-name">Mira</h2></div><p class="kid-headline"><span class="kid-headline-what clamp-1"><span class="kid-headline-keep clamp-1">up to +10 today</span><span class="kid-headline-rest clamp-1"> · 4 things today · Cross Country meet now</span></span></p><ul class="rows"><li class="row row-now"><span class="row-dot row-dot