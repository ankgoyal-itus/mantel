// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`the list > renders the next days 1`] = `"<div class="screen list"><header class="li-bar"><div class="li-segments"><button type="button" class="li-segment">Month</button><button type="button" class="li-segment li-segment-on">List</button></div><div class="li-chips"><button type="button" class="li-chip li-chip-on">All</button><button type="button" class="li-chip" style="--chip:var(--ink-mira)">Mira</button><button type="button" class="li-chip" style="--chip:var(--ink-kabir)">Kabir</button><button type="button" class="li-chip" style="--chip:var(--fg)">Family</button><button type="button" class="li-chip" style="--chip:var(--ink-school)">School</button><button type="button" class="li-chip" style="--chip:var(--ink-festival)">Festivals</button><button type="button" class="li-chip" style="--chip:var(--ink-holiday)">Holidays</button></div><button type="button" class="li-done">Done</button></header><div class="li-scroll"><section class="li-day"><header class="li-head"><span class="li-date">Tue 29 Sep</span></header><div class="li-row"><span class="li-who" aria-hidden="true"><span style="--kid:var(--shade-mira, var(--kid-mira, #1F8A8A));--kid-tint:var(--tint-mira, transparent);--kid-ink:var(--ink-mira, #1F8A8A);--kid-chip-ink:var(--chip-ink-mira, var(--ink-mira, #1F8A8A))"><span class="avatar" style="width:24px;height:24px" data-avatar="fox"><img class="avatar-animal" src="/src/avatars/fox.svg?no-inline" alt="" draggable="false"/></span></span></span><span class="li-time">All day</span><span class="li-title">Picture day</span></div><div class="li-row"><span class="li-who" aria-hidden="true"><span style="--kid:var(--shade-mira, var(--kid-mira, #1F8A8A));--kid-tint:var(--tint-mira, transparent);--kid-ink:var(--ink-mira, #1F8A8A);--kid-chip-ink:var(--chip-ink-mira, var(--ink-mira, #1F8A8A))"><span class="avatar" style="width:24px;height:24px" data-avatar="fox"><img class="avatar-animal" src="/src/avatars/fox.svg?no-inline" alt="" draggable="false"/></span></span></span><span class="li-time">9:00 am</span><span class="li-title">Assembly</span><span class="li-where">Gym</span></div><div class="li-row"><span class="li-who" aria-hidden="true"><span style="--kid:var(--shade-mira, var(--kid-mira, #1F8A8A));--kid-tint:var(--tint-mira, transparent);--kid-ink:var(--ink-mira, #1F8A8A);--kid-chip-ink:var(--chip-ink-mira, var(--ink-mira, #1F8A8A))"><span class="avatar" style="width:24px;height:24px" data-avatar="fox"><img class="avatar-animal" src="/src/avatars/fox.svg?no-inline" alt="" draggable="false"/></span></span></span><span class="li-time">3:00 pm</span><span class="li-title">Cross Country meet</span><svg class="li-glyph" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 3.5 2.5 9 12 14.5 21.5 9 12 3.5ZM6 11v6.5c0 1.5 2.7 3 6 3s6-1.5 6-3V11M21.5 9v5" vector-effect="non-scaling-stroke"></path></svg><span class="li-where">Bayside Middle</span></div><div class="li-row"><span class="li-who" aria-hidden="true"><span style="--kid:var(--shade-mira, var(--kid-mira, #1F8A8A));--kid-tint:var(--tint-mira, transparent);--kid-ink:var(--ink-mira, #1F8A8A);--kid-chip-ink:var(--chip-ink-mira, var(--ink-mira, #1F8A8A))"><span class="avatar" style="width:24px;height:24px" data-avatar="fox"><img class="avatar-animal" src="/src/avatars/fox.svg?no-inline" alt="" draggable="false"/></span></span></span><span class="li-time">4:00 pm</span><span class="li-title">Piano</span><span class="li-where">Ms. Lee&#x27;s</span></div><div class="li-row"><span class="li-who" aria-hidden="true"><svg class="li-family" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M8 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM16.5 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM2.5 20a5.5 5.5 0 0 1 11 0M11 20a5.5 5.5 0 0 1 11 0" vector-effect="non-scaling-stroke"></path></svg></span><span class="li-time">6:30 pm</span><span class="li-title">Dinner with grandparents</span></div></section><section class="li-day"><header class="li-head"><span class="li-date">Wed 30 Sep</span><span class="li-mark" style="color:var(--ink-festival)">Diwali/Deepavali</span><span class="li-mark" style="color:var(--ink-school)">No school</span></header><div class="li-row"><span class="li-who" aria-hidden="true"><span style="--kid:var(--shade-mira, var(--kid-mira, #1F8A8A));--kid-tint:var(--tint-mira, transparent);--kid-ink:var(--ink-mira, #1F8A8A);--kid-chip-ink:var(--chip-ink-mira, var(--ink-mira, #1F8A8A))"><span class="avatar" style="width:24px;height:24px" data-avatar="fox"><img class="avatar-animal" src="/src/avatars/fox.svg?no-inline" alt="" draggable="false"/></span></span></span><span class="li-time">10:30 am</span><span class="li-title">Dentist</span></div><div class="li-row"><span class="li-who" aria-hidden="true"><svg class="li-family" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M8 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM16.5 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM2.5 20a5.5 5.5 0 0 1 11 0M11 20a5.5 5.5 0 0 1 11 0" vector-effect="non-scaling-stroke"></path></svg></span><span class="li-time">10:30 am</span><span class="li-title">Library</span></div><div class="li-row"><span class="li-who" aria-hidden="true"><span style="--kid:var(--shade-kabir, var(--kid-kabir, #D97706));--kid-tint:var(--tint-kabir, transparent);--kid-ink:var(--ink-kabir, #D97706);--kid-chip-ink:var(--chip-ink-kabir, var(--ink-kabir, #D97706))"><span class="avatar" style="width:24px;height:24px" data-avatar="panda"><img class="avatar-animal" src="/src/avatars/panda.svg?no-inline" alt="" draggable="false"/></span></span></span><span class="li-time">5:00 pm</span><span class="li-title">Swim</span><span class="li-where">Aquatic center</span></div></section></div></div>"`;
