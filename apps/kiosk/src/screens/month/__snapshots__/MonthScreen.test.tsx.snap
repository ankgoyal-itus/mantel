// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`the month grid > renders October 2026 1`] = `"<div class="screen month"><div class="mo-main"><header class="mo-head"><div class="mo-title"><h1 class="mo-month">October 2026</h1><div class="mo-masa">Ashwin</div></div><div class="mo-nav"><button type="button" class="mo-button mo-toggle">Panchang</button><button type="button" class="mo-button">‹</button><button type="button" class="mo-button">›</button><button type="button" class="mo-button mo-done">Done</button></div></header><div class="mo-weekdays"><div class="mo-weekday">Sun</div><div class="mo-weekday">Mon</div><div class="mo-weekday">Tue</div><div class="mo-weekday">Wed</div><div class="mo-weekday">Thu</div><div class="mo-weekday">Fri</div><div class="mo-weekday">Sat</div></div><div class="mo-grid" style="grid-template-rows:repeat(5, 1fr)"><button type="button" class="mo-cell mo-out mo-past"><span class="mo-number">27</span></button><button type="button" class="mo-cell mo-out mo-past"><span class="mo-number">28</span></button><button type="button" class="mo-cell mo-out mo-past"><span class="mo-number">29</span></button><button type="button" class="mo-cell mo-out mo-past"><span class="mo-number">30</span></button><button type="button" class="mo-cell mo-past"><span class="mo-number">1</span></button><button type="button" class="mo-cell mo-past"><span class="mo-number">2</span></button><button type="button" class="mo-cell mo-past"><span class="mo-number">3</span></button><button type="button" class="mo-cell mo-past"><span class="mo-number">4</span></button><button type="button" class="mo-cell mo-past"><span class="mo-number">5</span></button><button type="button" class="mo-cell mo-past"><span class="mo-number">6</span></button><button type="button" class="mo-cell mo-past"><span class="mo-number">7</span></button><button type="button" class="mo-cell mo-past"><span class="mo-number">8</span></button><button type="button" class="mo-cell mo-past"><span class="mo-number">9</span></button><button type="button" class="mo-cell mo-past"><span class="mo-number">10</span></button><button type="button" class="mo-cell mo-today"><span class="mo-number">11</span><span class="mo-observance-name">Navratri</span><span class="mo-dots"><span class="mo-dot" style="background:var(--festival)"></span></span></button><button type="button" class="mo-cell"><span class="mo-number">12</span><span class="mo-bars" aria-hidden="true"><span class="mo-bar" style="background:#1F8A8A"></span><span class="mo-bar" style="background:#D97706"></span></span></button><button type="button" class="mo-cell"><span class="mo-number">13</span></button><button type="button" class="mo-cell"><span class="mo-number">14</span></button><button type="button" class="mo-cell"><span class="mo-number">15</span></button><button type="button" class="mo-cell"><span class="mo-number">16</span></button><button type="button" class="mo-cell"><span class="mo-number">17</span></button><button type="button" class="mo-cell"><span class="mo-number">18</span></button><button type="button" class="mo-cell"><span class="mo-number">19</span></button><button type="button" class="mo-cell"><span class="mo-number">20</span><span class="mo-observance-name">Dussehra</span><span class="mo-dots"><span class="mo-dot" style="background:var(--festival)"></span></span></button><button type="button" class="mo-cell"><span class="mo-number">21</span></button><button type="button" class="mo-cell"><span class="mo-number">22</span><span class="mo-bars" aria-hidden="true"><span class="mo-bar" style="background:#D97706"></span></span><span class="mo-dots"><span class="mo-dot" style="background:var(--muted)"></span></span></button><button type="button" class="mo-cell mo-noschool"><span class="mo-number">23</span><span class="mo-noschool-note">No school</span></button><button type="button" class="mo-cell"><span class="mo-number">24</span></button><button type="button" class="mo-cell"><span class="mo-number">25</span></button><button type="button" class="mo-cell"><span class="mo-number">26</span></button><button type="button" class="mo-cell"><span class="mo-number">27</span></button><button type="button" class="mo-cell"><span class="mo-number">28</span></button><button type="button" class="mo-cell"><span class="mo-number">29</span></button><button type="button" class="mo-cell"><span class="mo-number">30</span></button><button type="button" class="mo-cell"><span class="mo-number">31</span></button></div><div class="mo-legend"><span class="mo-key"><span class="mo-key-bar" style="background:#1F8A8A"></span>mira</span><span class="mo-key"><span class="mo-key-bar" style="background:#D97706"></span>kabir</span><span class="mo-key"><span class="mo-dot" style="background:var(--muted)"></span>Family</span><span class="mo-key"><span class="mo-key-hatch"></span>No school</span><span class="mo-key"><span class="mo-dot" style="background:var(--festival)"></span>Festival</span><span class="mo-key"><span class="mo-dot" style="background:var(--holiday)"></span>Holiday</span><span class="mo-key"><svg class="mo-key-glyph mo-key-leaf" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20 4c0 9-5.5 13.5-11.5 13.5C8.5 8.5 14 4 20 4ZM6 20c1.5-4 4.5-7.5 8.5-9.5" vector-effect="non-scaling-stroke"></path></svg>Veg</span><span class="mo-key"><svg class="mo-key-glyph" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><circle cx="8" cy="8" r="5.5" fill="none" stroke="currentColor" stroke-width="1.75" vector-effect="non-scaling-stroke"></circle></svg>New moon</span><span class="mo-key"><svg class="mo-key-glyph" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><circle cx="8" cy="8" r="5.5" fill="currentColor" stroke="currentColor" stroke-width="1.75" vector-effect="non-scaling-stroke"></circle></svg>Full moon</span></div></div></div>"`;
