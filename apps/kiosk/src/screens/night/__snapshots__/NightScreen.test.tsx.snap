// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`the night screen > renders the night 1`] = `"<div class="screen screen-night night"><div class="night-col"><div class="night-clock" data-clock="true">10:00<span class="night-ampm">pm</span></div><div class="night-date">29 September</div><div class="night-weather"><div class="night-wx">Partly cloudy · 68° now</div><div class="night-wx night-wx-next">Tomorrow 74° / 52° · rain 10% · sunrise 7:00</div></div><section class="night-block"><h2 class="night-head"><span>Tomorrow</span><span class="night-head-date">Wed 30 Sep</span><span class="night-badge night-observance">Diwali/Deepavali</span><span class="night-badge">No school</span></h2><div class="night-row" style="--kid:var(--shade-mira, var(--kid-mira, #1F8A8A));--kid-tint:var(--tint-mira, transparent);--kid-ink:var(--ink-mira, #1F8A8A);--kid-chip-ink:var(--chip-ink-mira, var(--ink-mira, #1F8A8A))"><span class="avatar" style="width:24px;height:24px" data-avatar="fox"><img class="avatar-animal" src="/src/avatars/fox.svg?no-inline" alt="" draggable="false"/></span><span class="night-who night-who-kid">Mira</span><span class="night-items"><span class="night-item">10:30 am Dentist</span></span></div><div class="night-row" style="--kid:var(--shade-kabir, var(--kid-kabir, #D97706));--kid-tint:var(--tint-kabir, transparent);--kid-ink:var(--ink-kabir, #D97706);--kid-chip-ink:var(--chip-ink-kabir, var(--ink-kabir, #D97706))"><span class="avatar" style="width:24px;height:24px" data-avatar="panda"><img class="avatar-animal" src="/src/avatars/panda.svg?no-inline" alt="" draggable="false"/></span><span class="night-who night-who-kid">Kabir</span><span class="night-items"><span class="night-item">5:00 pm Swim</span></span></div><div class="night-row"><span class="night-who">Family</span><span class="night-items"><span class="night-item">10:30 am Library</span></span></div></section><section class="night-block night-pack"><h2 class="night-head"><span>Pack</span></h2><div class="night-pack-row"><span class="night-pack-label">Breakfast</span><span class="night-pack-name">Pancakes</span></div><div class="night-pack-row"><span class="night-pack-label">Lunch</span><span class="night-pack-name">Dal and rice</span><span class="night-pack-note">lunchbox</span></div></section></div></div>"`;
